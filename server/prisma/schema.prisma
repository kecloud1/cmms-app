generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Asset {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  status    String
  createdAt DateTime @default(now())
}